    "@types/node": "^25.5.2",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "ejs": "^5.0.1",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.3.3",
    "morgan": "^1.10.1",
    "multer": "^2.1.1",
    "typescript": "^6.0.2"
  },
  "devDependencies": {
    "@types/mongoose": "^5.11.96",
    "nodemon": "^3.1.14",
